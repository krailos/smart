# ЗРАЗОК. На сервері: cp .env.example .env  і впишіть справжні значення. Файл .env у git НЕ потрапляє.
# Для перевірки вдома (Docker Desktop): DOMAIN=localhost

# домен сайту (без https:// і без www)
DOMAIN=smartapp.com.ua
# пароль користувача smart до бази PostgreSQL у контейнері — довгий, випадковий (напр. openssl rand -base64 24)
DB_PASSWORD=change-me
